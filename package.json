{
  "name": "earth-digital-twin",
  "version": "1.0.0",
  "private": true,
  "description": "Earth Digital Twin AI — real-time planetary intelligence platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "predev": "npm run build:shared",
    "dev": "npm-run-all --parallel dev:web dev:api",
    "dev:web": "npm run dev --workspace @edt/web",
    "dev:api": "npm run start:dev --workspace @edt/api",
    "prebuild": "npm run build:shared",
    "build": "npm-run-all --parallel build:web build:api",
    "build:web": "npm run build --workspace @edt/web",
    "build:api": "npm run build --workspace @edt/api",
    "build:shared": "npm run build --workspace @edt/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "db:migrate": "npm run db:migrate --workspace @edt/api",
    "db:seed": "npm run db:seed --workspace @edt/api",
    "build:city-index": "node scripts/build-city-index.mjs",
    "build:city-index:openmeteo": "node scripts/build-city-index-openmeteo.mjs",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "npm-run-all": "4.1.5",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "typescript": "5.7.3"
  },
  "overrides": {
    "zod": "3.25.76"
  }
}
