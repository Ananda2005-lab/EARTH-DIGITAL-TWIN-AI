# ── Authentication ───────────────────────────────────────────────────────────
# Shared secret sent by the NestJS backend as "Authorization: Bearer <token>".
# Leave empty to disable auth (development mode).
AI_SERVICE_TOKEN=

# ── OpenAI ───────────────────────────────────────────────────────────────────
# When set, real OpenAI completions are used; otherwise intelligent mocks fire.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
MAX_TOKENS=2000
TEMPERATURE=0.7

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
