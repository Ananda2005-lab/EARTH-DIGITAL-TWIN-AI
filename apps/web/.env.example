# Earth Digital Twin AI — web environment
#
# Copy to `.env.local`. Server-only values are validated by src/lib/env.ts on
# first use; `NEXT_PUBLIC_*` values are inlined into the client bundle, so never
# put a secret behind that prefix.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_BASE_URL=http://localhost:4000/api/v1
AI_BASE_URL=http://localhost:8000
UPSTREAM_TIMEOUT_MS=12000

# ── Client ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Relative by default so browser traffic goes through the Next.js route handlers
# rather than hitting the API directly and tripping CORS.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ── Optional provider keys (features self-disable when absent) ────────────────
# Direct-from-server fallbacks used when the API is unreachable.
NASA_FIRMS_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AISSTREAM_API_KEY=
# https://developer.tomtom.com/  — traffic flow and incident tiles
TOMTOM_API_KEY=
# https://cloud.maptiler.com/  — basemap styles and terrain tiles
MAPTILER_API_KEY=
# https://ion.cesium.com/  — world terrain and photogrammetry tiles
CESIUM_ION_TOKEN=
