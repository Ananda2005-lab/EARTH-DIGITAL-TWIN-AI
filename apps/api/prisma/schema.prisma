// Earth Digital Twin AI — persistence model.
//
// Conventions
//   * UUID primary keys generated by the client (`@default(uuid())`); the
//     hand-written migration additionally sets `gen_random_uuid()` as a column
//     default so raw SQL inserts (ops scripts, fixtures) stay safe.
//   * Every table name is snake_case via `@@map`, every column via `@map`.
//   * Enums mirror the string unions exported from `@edt/shared`, so a contract
//     change fails the build in both tiers at once.
//   * Check constraints, GIST/GIN indexes and extensions live in the migration:
//     Prisma has no schema syntax for them. See prisma/migrations/0001_init.
//
// Why both `geom` and plain `lng`/`lat` columns exist
//   PostGIS `geography(Point,4326)` is what makes radius, nearest-neighbour and
//   containment queries fast and correct (great-circle distances, GIST index).
//   Prisma Client cannot read or write `Unsupported(...)` columns, and PostGIS
//   is not guaranteed in every environment (CI containers, SQLite-free local
//   runs, managed providers without the extension). So the authoritative,
//   always-readable values are the plain `lng`/`lat` doubles that Prisma maps
//   normally; `geom` is a derived column populated by trigger/backfill SQL and
//   used exclusively from parameterised raw spatial queries. Losing PostGIS
//   degrades performance, never correctness.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto, pg_trgm]
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  user
  analyst
  admin
  owner

  @@map("user_role")
}

enum UserStatus {
  active
  suspended
  unverified

  @@map("user_status")
}

enum SubscriptionPlan {
  free
  pro
  team
  enterprise

  @@map("subscription_plan")
}

enum AuthProviderKind {
  password
  google
  github

  @@map("auth_provider")
}

enum Theme {
  dark
  light
  system

  @@map("theme")
}

enum UnitSystem {
  metric
  imperial

  @@map("unit_system")
}

enum TemperatureUnit {
  celsius
  fahrenheit

  @@map("temperature_unit")
}

enum LabelDensity {
  minimal
  balanced
  detailed

  @@map("label_density")
}

enum EmailDigest {
  off
  daily
  weekly

  @@map("email_digest")
}

enum BookmarkKind {
  place
  view
  area
  route

  @@map("bookmark_kind")
}

enum HistoryKind {
  search
  place
  report
  ai
  layer

  @@map("history_kind")
}

enum WorkspaceVisibility {
  private
  team
  public

  @@map("workspace_visibility")
}

enum WorkspaceRole {
  viewer
  editor
  owner

  @@map("workspace_role")
}

enum AnnotationKind {
  marker
  line
  polygon
  circle
  text
  measure

  @@map("annotation_kind")
}

enum ReportKind {
  country_profile
  city_profile
  area_summary
  environmental_risk
  climate_outlook
  comparison
  travel_plan
  custom

  @@map("report_kind")
}

enum ReportStatus {
  queued
  generating
  ready
  failed

  @@map("report_status")
}

enum ReportFormat {
  markdown
  pdf
  docx

  @@map("report_format")
}

enum ReportTone {
  executive
  technical
  academic
  casual

  @@map("report_tone")
}

enum NotificationKind {
  hazard
  report
  system
  ai
  billing
  security

  @@map("notification_kind")
}

enum NotificationSeverity {
  info
  success
  warning
  critical

  @@map("notification_severity")
}

enum NotificationAudience {
  all
  free
  pro
  team
  enterprise
  admins

  @@map("notification_audience")
}

enum ChatRole {
  system
  user
  assistant
  tool

  @@map("chat_role")
}

enum HazardKind {
  earthquake
  wildfire
  volcano
  flood
  cyclone
  drought
  landslide
  tsunami

  @@map("hazard_kind")
}

enum HazardSeverity {
  info
  low
  moderate
  high
  extreme

  @@map("hazard_severity")
}

enum AlertChannel {
  in_app
  email
  webhook

  @@map("alert_channel")
}

enum AuditOutcome {
  success
  failure

  @@map("audit_outcome")
}

enum FlagAudience {
  free
  pro
  team
  enterprise
  internal

  @@map("flag_audience")
}

enum AttachmentKind {
  report_export
  avatar
  workspace_asset
  data_import

  @@map("attachment_kind")
}

enum Continent {
  AFRICA        @map("Africa")
  ANTARCTICA    @map("Antarctica")
  ASIA          @map("Asia")
  EUROPE        @map("Europe")
  NORTH_AMERICA @map("North America")
  OCEANIA       @map("Oceania")
  SOUTH_AMERICA @map("South America")

  @@map("continent")
}

enum DrivingSide {
  left
  right

  @@map("driving_side")
}

// ── Identity ──────────────────────────────────────────────────────────────────

model User {
  id               String           @id @default(uuid()) @db.Uuid
  email            String           @unique
  passwordHash     String?          @map("password_hash")
  name             String
  avatarUrl        String?          @map("avatar_url")
  role             UserRole         @default(user)
  plan             SubscriptionPlan @default(free)
  status           UserStatus       @default(unverified)
  organisation     String?
  jobTitle         String?          @map("job_title")
  locale           String           @default("en")
  timezone         String           @default("UTC")
  emailVerified    Boolean          @default(false) @map("email_verified")
  emailVerifiedAt  DateTime?        @map("email_verified_at")
  mfaEnabled       Boolean          @default(false) @map("mfa_enabled")
  marketingOptIn   Boolean          @default(false) @map("marketing_opt_in")
  acceptedTermsAt  DateTime?        @map("accepted_terms_at")
  lastLoginAt      DateTime?        @map("last_login_at")
  lastSeenAt       DateTime?        @map("last_seen_at")
  failedLoginCount Int              @default(0) @map("failed_login_count")
  lockedUntil      DateTime?        @map("locked_until")
  suspendedAt      DateTime?        @map("suspended_at")
  suspendedReason  String?          @map("suspended_reason")
  deletedAt        DateTime?        @map("deleted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  oauthAccounts          OAuthAccount[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  verificationTokens     EmailVerificationToken[]
  mfaSecret              MfaSecret?
  preference             UserPreference?
  sessions               Session[]
  bookmarks              Bookmark[]
  bookmarkCollections    BookmarkCollection[]
  history                HistoryEntry[]
  workspaces             Workspace[]              @relation("workspace_owner")
  workspaceMemberships   WorkspaceMember[]        @relation("workspace_member_user")
  workspaceInvitesSent   WorkspaceMember[]        @relation("workspace_member_inviter")
  annotations            Annotation[]
  reports                Report[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  conversations          Conversation[]
  aiUsageLogs            AiUsageLog[]
  apiKeys                ApiKey[]
  auditLogs              AuditLog[]
  savedSearches          SavedSearch[]
  alerts                 Alert[]
  attachments            Attachment[]
  featureFlagUpdates     FeatureFlag[]            @relation("feature_flag_editor")

  @@index([role])
  @@index([plan])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model OAuthAccount {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  provider          AuthProviderKind
  providerAccountId String           @map("provider_account_id")
  email             String?
  displayName       String?          @map("display_name")
  avatarUrl         String?          @map("avatar_url")
  scope             String?
  tokenType         String?          @map("token_type")
  accessTokenHash   String?          @map("access_token_hash")
  refreshTokenHash  String?          @map("refresh_token_hash")
  expiresAt         DateTime?        @map("expires_at")
  lastLoginAt       DateTime?        @map("last_login_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Rotating refresh tokens. Only the SHA-256 hash is stored; a family is the
/// chain produced by successive rotations and is revoked wholesale when a
/// already-used token is replayed (reuse detection).
model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  sessionId     String?   @map("session_id") @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  parentId      String?   @map("parent_id") @db.Uuid
  replacedById  String?   @map("replaced_by_id") @db.Uuid
  usedAt        DateTime? @map("used_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  expiresAt     DateTime  @map("expires_at")
  ip            String?
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// TOTP secret, encrypted with AES-256-GCM using MFA_ENCRYPTION_KEY.
model MfaSecret {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted")
  algorithm       String    @default("SHA1")
  digits          Int       @default(6)
  period          Int       @default(30)
  recoveryHashes  String[]  @map("recovery_hashes")
  confirmedAt     DateTime? @map("confirmed_at")
  lastUsedAt      DateTime? @map("last_used_at")
  lastUsedCounter BigInt?   @map("last_used_counter")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_secrets")
}

model UserPreference {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @unique @map("user_id") @db.Uuid
  theme               Theme           @default(dark)
  units               UnitSystem      @default(metric)
  temperatureUnit     TemperatureUnit @default(celsius) @map("temperature_unit")
  mapBasemap          String          @default("satellite") @map("map_basemap")
  defaultLayers       String[]        @default(["borders", "labels"]) @map("default_layers")
  reducedMotion       Boolean         @default(false) @map("reduced_motion")
  highContrast        Boolean         @default(false) @map("high_contrast")
  labelDensity        LabelDensity    @default(balanced) @map("label_density")
  autoRotateGlobe     Boolean         @default(true) @map("auto_rotate_globe")
  telemetryOptIn      Boolean         @default(true) @map("telemetry_opt_in")
  emailDigest         EmailDigest     @default(weekly) @map("email_digest")
  hazardAlertRadiusKm Int             @default(250) @map("hazard_alert_radius_km")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @unique @map("family_id") @db.Uuid
  ip           String?
  userAgent    String?   @map("user_agent")
  device       String?
  browser      String?
  os           String?
  city         String?
  countryCode  String?   @map("country_code") @db.Char(2)
  current      Boolean   @default(false)
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, lastActiveAt])
  @@index([expiresAt])
  @@map("sessions")
}

// ── Saved work ────────────────────────────────────────────────────────────────

model BookmarkCollection {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  description String?
  color       String   @default("#818cf8")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]

  @@unique([userId, name])
  @@index([userId])
  @@map("bookmark_collections")
}

model Bookmark {
  id           String                                @id @default(uuid()) @db.Uuid
  userId       String                                @map("user_id") @db.Uuid
  collectionId String?                               @map("collection_id") @db.Uuid
  name         String
  description  String?
  kind         BookmarkKind                          @default(place)
  lng          Float
  lat          Float
  /// Derived PostGIS point; see the header note on the dual representation.
  geom         Unsupported("geography(Point, 4326)")?
  view         Json?
  bboxWest     Float?                                @map("bbox_west")
  bboxSouth    Float?                                @map("bbox_south")
  bboxEast     Float?                                @map("bbox_east")
  bboxNorth    Float?                                @map("bbox_north")
  countryCode  String?                               @map("country_code") @db.Char(2)
  tags         String[]                              @default([])
  color        String                                @default("#38bdf8")
  pinned       Boolean                               @default(false)
  createdAt    DateTime                              @default(now()) @map("created_at")
  updatedAt    DateTime                              @updatedAt @map("updated_at")

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection BookmarkCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([collectionId])
  @@index([countryCode])
  @@index([userId, pinned])
  @@map("bookmarks")
}

model HistoryEntry {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  kind      HistoryKind
  label     String
  detail    String?
  lng       Float?
  lat       Float?
  metadata  Json        @default("{}")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([kind])
  @@map("history_entries")
}

model Workspace {
  id          String              @id @default(uuid()) @db.Uuid
  ownerId     String              @map("owner_id") @db.Uuid
  name        String
  description String?
  view        Json
  layers      String[]            @default([])
  visibility  WorkspaceVisibility @default(private)
  shareSlug   String?             @unique @map("share_slug")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  owner       User              @relation("workspace_owner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  annotations Annotation[]
  attachments Attachment[]

  @@index([ownerId, updatedAt])
  @@index([visibility])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(viewer)
  invitedById String?       @map("invited_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("workspace_member_user", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("workspace_member_inviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Annotation {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  createdById String         @map("created_by_id") @db.Uuid
  kind        AnnotationKind
  label       String         @default("")
  color       String         @default("#22d3ee")
  /// Array of `{ lng, lat }` vertices in draw order.
  coordinates Json
  radiusM     Float?         @map("radius_m")
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdById])
  @@map("annotations")
}

// ── Reports ───────────────────────────────────────────────────────────────────

model Report {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  title         String
  kind          ReportKind
  status        ReportStatus @default(queued)
  format        ReportFormat @default(markdown)
  tone          ReportTone   @default(executive)
  includeCharts Boolean      @default(true) @map("include_charts")
  content       String?
  summary       String?
  target        Json
  tokensUsed    Int?         @map("tokens_used")
  generationMs  Int?         @map("generation_ms")
  error         String?
  jobId         String?      @map("job_id")
  completedAt   DateTime?    @map("completed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections    ReportSection[]
  attachments Attachment[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([kind])
  @@map("reports")
}

model ReportSection {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  position  Int
  heading   String
  body      String
  charts    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, position])
  @@map("report_sections")
}

// ── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id           String                @id @default(uuid()) @db.Uuid
  userId       String?               @map("user_id") @db.Uuid
  kind         NotificationKind      @default(system)
  severity     NotificationSeverity  @default(info)
  title        String
  body         String
  actionUrl    String?               @map("action_url")
  audience     NotificationAudience? 
  readAt       DateTime?             @map("read_at")
  scheduledFor DateTime?             @map("scheduled_for")
  sentAt       DateTime?             @map("sent_at")
  metadata     Json                  @default("{}")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([kind])
  @@index([scheduledFor])
  @@map("notifications")
}

model NotificationPreference {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @unique @map("user_id") @db.Uuid
  channelInApp      Boolean            @default(true) @map("channel_in_app")
  channelEmail      Boolean            @default(true) @map("channel_email")
  channelWebhook    Boolean            @default(false) @map("channel_webhook")
  webhookUrl        String?            @map("webhook_url")
  hazardMinSeverity HazardSeverity     @default(high) @map("hazard_min_severity")
  digest            EmailDigest        @default(weekly)
  quietHoursStart   Int?               @map("quiet_hours_start")
  quietHoursEnd     Int?               @map("quiet_hours_end")
  mutedKinds        NotificationKind[] @default([]) @map("muted_kinds")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ── AI ────────────────────────────────────────────────────────────────────────

model Conversation {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  title              String    @default("New conversation")
  pinned             Boolean   @default(false)
  messageCount       Int       @default(0) @map("message_count")
  lastMessagePreview String?   @map("last_message_preview")
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  usage    AiUsageLog[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model ChatMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           ChatRole
  content        String
  intent         String?
  citations      Json?
  actions        Json?
  toolCalls      Json?    @map("tool_calls")
  tokensUsed     Int?     @map("tokens_used")
  latencyMs      Int?     @map("latency_ms")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model AiUsageLog {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  conversationId   String?  @map("conversation_id") @db.Uuid
  model            String
  intent           String?
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  latencyMs        Int      @default(0) @map("latency_ms")
  costUsd          Decimal? @map("cost_usd") @db.Decimal(12, 6)
  ok               Boolean  @default(true)
  errorCode        String?  @map("error_code")
  flagged          Boolean  @default(false)
  requestId        String?  @map("request_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([flagged])
  @@map("ai_usage_logs")
}

// ── Reference gazetteer ───────────────────────────────────────────────────────

model Country {
  id             String                                @id @default(uuid()) @db.Uuid
  code           String                                @unique @db.Char(2)
  code3          String                                @unique @db.Char(3)
  numeric        String?                               @db.Char(3)
  name           String
  officialName   String                                @map("official_name")
  continent      Continent
  region         String?
  subregion      String?
  capital        String?
  population     BigInt                                @default(0)
  populationYear Int?                                  @map("population_year")
  areaKm2        Float                                 @default(0) @map("area_km2")
  flagEmoji      String                                @map("flag_emoji")
  lng            Float
  lat            Float
  capitalLng     Float?                                @map("capital_lng")
  capitalLat     Float?                                @map("capital_lat")
  /// Derived PostGIS point; see the header note on the dual representation.
  geom           Unsupported("geography(Point, 4326)")?
  bboxWest       Float?                                @map("bbox_west")
  bboxSouth      Float?                                @map("bbox_south")
  bboxEast       Float?                                @map("bbox_east")
  bboxNorth      Float?                                @map("bbox_north")
  currencies     Json                                  @default("[]")
  languages      Json                                  @default("[]")
  timezones      String[]                              @default([])
  callingCodes   String[]                              @default([]) @map("calling_codes")
  tld            String[]                              @default([])
  drivingSide    DrivingSide?                          @map("driving_side")
  independent    Boolean                               @default(true)
  unMember       Boolean                               @default(true) @map("un_member")
  landlocked     Boolean                               @default(false)
  borders        String[]                              @default([])
  demonym        String?
  incomeGroup    String?                               @map("income_group")
  altSpellings   String[]                              @default([]) @map("alt_spellings")
  flagSvgUrl     String                                @map("flag_svg_url")
  coatOfArmsUrl  String?                               @map("coat_of_arms_url")
  mapsUrl        String?                               @map("maps_url")
  wikipediaUrl   String?                               @map("wikipedia_url")
  summary        String?
  createdAt      DateTime                              @default(now()) @map("created_at")
  updatedAt      DateTime                              @updatedAt @map("updated_at")

  indicators CountryIndicator[]
  cities     City[]

  @@index([continent])
  @@index([name])
  @@index([population])
  @@map("countries")
}

model CountryIndicator {
  id        String   @id @default(uuid()) @db.Uuid
  countryId String   @map("country_id") @db.Uuid
  indicator String
  label     String
  unit      String   @default("")
  source    String   @default("World Bank")
  year      Int
  value     Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, indicator, year])
  @@index([indicator, year])
  @@map("country_indicators")
}

model City {
  id                  String                                @id @default(uuid()) @db.Uuid
  geonameId           Int?                                  @unique @map("geoname_id")
  countryId           String                                @map("country_id") @db.Uuid
  countryCode         String                                @map("country_code") @db.Char(2)
  name                String
  asciiName           String                                @map("ascii_name")
  slug                String
  admin1              String?
  admin2              String?
  population          Int                                   @default(0)
  lng                 Float
  lat                 Float
  /// Derived PostGIS point; see the header note on the dual representation.
  geom                Unsupported("geography(Point, 4326)")?
  elevationM          Int?                                  @map("elevation_m")
  timezone            String                                @default("UTC")
  isCapital           Boolean                               @default(false) @map("is_capital")
  metroPopulation     Int?                                  @map("metro_population")
  areaKm2             Float?                                @map("area_km2")
  populationDensity   Float?                                @map("population_density")
  foundedYear         Int?                                  @map("founded_year")
  gdpUsd              BigInt?                               @map("gdp_usd")
  costOfLivingIndex   Float?                                @map("cost_of_living_index")
  qualityOfLifeIndex  Float?                                @map("quality_of_life_index")
  safetyIndex         Float?                                @map("safety_index")
  transitScore        Float?                                @map("transit_score")
  walkScore           Float?                                @map("walk_score")
  averageTemperature  Float?                                @map("average_temperature")
  averageAqi          Float?                                @map("average_aqi")
  nearestAirports     String[]                              @default([]) @map("nearest_airports")
  sisterCities        String[]                              @default([]) @map("sister_cities")
  wikipediaUrl        String?                               @map("wikipedia_url")
  summary             String?
  createdAt           DateTime                              @default(now()) @map("created_at")
  updatedAt           DateTime                              @updatedAt @map("updated_at")

  country Country      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  metrics CityMetric[]

  @@unique([countryCode, slug])
  @@index([countryCode])
  @@index([name])
  @@index([population])
  @@index([isCapital])
  @@map("cities")
}

model CityMetric {
  id        String   @id @default(uuid()) @db.Uuid
  cityId    String   @map("city_id") @db.Uuid
  metric    String
  label     String
  unit      String   @default("")
  source    String   @default("Earth Digital Twin")
  period    String
  value     Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, metric, period])
  @@index([metric])
  @@map("city_metrics")
}

model Airport {
  id          String   @id @default(uuid()) @db.Uuid
  icao        String   @unique @db.Char(4)
  iata        String?  @db.Char(3)
  name        String
  city        String?
  countryCode String   @map("country_code") @db.Char(2)
  lng         Float
  lat         Float
  elevationM  Int?     @map("elevation_m")
  timezone    String?
  passengers  BigInt?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([countryCode])
  @@index([iata])
  @@index([name])
  @@map("airports")
}

model Seaport {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  countryCode String   @map("country_code") @db.Char(2)
  lng         Float
  lat         Float
  teu         BigInt?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([countryCode])
  @@index([name])
  @@map("seaports")
}

/// Warm copy of fused upstream hazard feeds. Redis holds the hot payload; this
/// table is the durable record used for alert fan-out and historical queries.
model HazardEventCache {
  id                 String         @id @default(uuid()) @db.Uuid
  externalId         String         @unique @map("external_id")
  kind               HazardKind
  title              String
  severity           HazardSeverity
  intensity          Float          @default(0)
  lng                Float
  lat                Float
  depthKm            Float?         @map("depth_km")
  magnitude          Float?
  frpMw              Float?         @map("frp_mw")
  affectedPopulation Int?           @map("affected_population")
  place              String?
  countryCode        String?        @map("country_code") @db.Char(2)
  tsunamiWarning     Boolean        @default(false) @map("tsunami_warning")
  source             String
  sourceUrl          String?        @map("source_url")
  startedAt          DateTime       @map("started_at")
  sourceUpdatedAt    DateTime       @map("source_updated_at")
  notifiedAt         DateTime?      @map("notified_at")
  expiresAt          DateTime       @map("expires_at")
  raw                Json?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([kind, startedAt])
  @@index([severity, startedAt])
  @@index([expiresAt])
  @@index([notifiedAt])
  @@map("hazard_event_cache")
}

// ── Platform operations ───────────────────────────────────────────────────────

model FeatureFlag {
  id          String         @id @default(uuid()) @db.Uuid
  key         String         @unique
  label       String
  description String         @default("")
  enabled     Boolean        @default(false)
  rollout     Int            @default(0)
  audience    FlagAudience[] @default([internal])
  updatedById String?        @map("updated_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  updatedBy User? @relation("feature_flag_editor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([enabled])
  @@map("feature_flags")
}

/// Machine credentials. Only the SHA-256 hash of the secret is persisted; the
/// plaintext is returned exactly once at issue/rotate time.
model ApiKey {
  id                 String    @id @default(uuid()) @db.Uuid
  ownerId            String    @map("owner_id") @db.Uuid
  name               String
  prefix             String
  suffix             String    @db.VarChar(8)
  keyHash            String    @unique @map("key_hash")
  scopes             String[]  @default([])
  rateLimitPerMinute Int       @default(120) @map("rate_limit_per_minute")
  usageCount         BigInt    @default(0) @map("usage_count")
  lastUsedAt         DateTime? @map("last_used_at")
  lastUsedIp         String?   @map("last_used_ip")
  rotatedFromId      String?   @map("rotated_from_id") @db.Uuid
  expiresAt          DateTime? @map("expires_at")
  revokedAt          DateTime? @map("revoked_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([revokedAt])
  @@map("api_keys")
}

model AuditLog {
  id         String       @id @default(uuid()) @db.Uuid
  actorId    String?      @map("actor_id") @db.Uuid
  actorEmail String?      @map("actor_email")
  action     String
  resource   String
  resourceId String?      @map("resource_id")
  ip         String?
  userAgent  String?      @map("user_agent")
  outcome    AuditOutcome @default(success)
  metadata   Json         @default("{}")
  requestId  String?      @map("request_id")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resource, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model UsageMetric {
  id           String   @id @default(uuid()) @db.Uuid
  scope        String   @default("global")
  bucket       DateTime
  requests     Int      @default(0)
  errors       Int      @default(0)
  p95LatencyMs Int      @default(0) @map("p95_latency_ms")
  aiTokens     Int      @default(0) @map("ai_tokens")
  uniqueUsers  Int      @default(0) @map("unique_users")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([scope, bucket])
  @@index([bucket])
  @@map("usage_metrics")
}

model SavedSearch {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String
  query     String
  filters   Json      @default("{}")
  notify    Boolean   @default(false)
  lastRunAt DateTime? @map("last_run_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("saved_searches")
}

/// Geofenced hazard subscription: notify me when a matching event happens
/// within `radiusKm` of (`lng`,`lat`).
model Alert {
  id              String                                @id @default(uuid()) @db.Uuid
  userId          String                                @map("user_id") @db.Uuid
  name            String
  kinds           HazardKind[]                          @default([])
  minSeverity     HazardSeverity                        @default(moderate) @map("min_severity")
  lng             Float
  lat             Float
  radiusKm        Float                                 @default(250) @map("radius_km")
  /// Derived PostGIS point; see the header note on the dual representation.
  geom            Unsupported("geography(Point, 4326)")?
  channels        AlertChannel[]                        @default([in_app])
  webhookUrl      String?                               @map("webhook_url")
  active          Boolean                               @default(true)
  triggerCount    Int                                   @default(0) @map("trigger_count")
  lastTriggeredAt DateTime?                             @map("last_triggered_at")
  muteUntil       DateTime?                             @map("mute_until")
  createdAt       DateTime                              @default(now()) @map("created_at")
  updatedAt       DateTime                              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@index([active])
  @@map("alerts")
}

model Attachment {
  id          String         @id @default(uuid()) @db.Uuid
  ownerId     String         @map("owner_id") @db.Uuid
  reportId    String?        @map("report_id") @db.Uuid
  workspaceId String?        @map("workspace_id") @db.Uuid
  kind        AttachmentKind @default(report_export)
  filename    String
  mimeType    String         @map("mime_type")
  sizeBytes   Int            @map("size_bytes")
  storageKey  String         @unique @map("storage_key")
  checksum    String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  report    Report?    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([reportId])
  @@index([workspaceId])
  @@map("attachments")
}
