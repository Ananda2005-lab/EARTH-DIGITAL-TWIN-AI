# Earth Digital Twin AI — API environment
#
# Copy to `.env` (or `.env.local`) and fill in the required values. Every variable
# is validated once at boot by src/config/env.schema.ts, so a bad value fails
# immediately with a list of every problem.
#
# Only the four values under "Required" have no default.

# ── Required ──────────────────────────────────────────────────────────────────
# Matches infra/docker/docker-compose.yml.
DATABASE_URL=postgresql://edt:edt_local_dev@localhost:5432/edt?schema=public
# Minimum 32 characters each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-character-secret
# Encrypts TOTP secrets at rest. Rotating it invalidates every enrolled device.
MFA_ENCRYPTION_KEY=replace-me-with-another-32-plus-character-secret

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=Earth Digital Twin AI API
PORT=4000
HOST=0.0.0.0
WEB_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=true
SWAGGER_ENABLED=true
MAINTENANCE_MODE=false
SHUTDOWN_TIMEOUT_MS=10000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true
DATABASE_LOG_QUERIES=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=edt:
CACHE_TTL_DEFAULT=60

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=earth-digital-twin
JWT_AUDIENCE=earth-digital-twin-web
BCRYPT_COST=12
MFA_ISSUER=Earth Digital Twin
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFY_TTL_HOURS=48
MAX_FAILED_LOGINS=8
LOGIN_LOCK_MINUTES=15

# ── OAuth (optional; each provider registers only when both keys are present) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/auth/callback
OAUTH_FAILURE_REDIRECT=http://localhost:3000/login?error=oauth

# ── Mail (optional; transactional mail is skipped while disabled) ─────────────
MAIL_ENABLED=false
MAIL_FROM=Earth Digital Twin <no-reply@earthdigitaltwin.ai>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ── Rate limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=240
AUTH_THROTTLE_TTL_SECONDS=300
AUTH_THROTTLE_LIMIT=10

# ── Upstream providers ────────────────────────────────────────────────────────
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_RETRIES=2
UPSTREAM_BACKOFF_MS=250
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_MS=30000

# ── AI service ────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
AI_MODEL=edt-analyst-1
AI_TIMEOUT_MS=60000
AI_DAILY_TOKEN_BUDGET=2000000

# ── Optional data feeds (each feature self-disables without its key) ──────────
# https://firms.modaps.eosdis.nasa.gov/api/area/  — active fire detections
NASA_FIRMS_API_KEY=
# https://opensky-network.org/  — flight positions
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# https://aisstream.io/  — live AIS vessel stream
AISSTREAM_API_KEY=
AISSTREAM_BBOX=-180,-90,180,90
AISSTREAM_SNAPSHOT_TTL=120

# ── Background jobs ───────────────────────────────────────────────────────────
QUEUE_PREFIX=edt-jobs
QUEUE_CONCURRENCY=4
JOBS_ENABLED=true
CACHE_WARM_CRON_ENABLED=true

# ── Seed data ─────────────────────────────────────────────────────────────────
# Passwords are generated and printed by the seed script when left blank.
SEED_OWNER_EMAIL=owner@earthdigitaltwin.ai
SEED_OWNER_PASSWORD=
SEED_ADMIN_EMAIL=admin@earthdigitaltwin.ai
SEED_ADMIN_PASSWORD=
SEED_ANALYST_EMAIL=analyst@earthdigitaltwin.ai
SEED_ANALYST_PASSWORD=
SEED_DEMO_EMAIL=demo@earthdigitaltwin.ai
SEED_DEMO_PASSWORD=
SEED_CITY_LIMIT=2000
